{
  "name": "tauri-app",
  "version": "0.1.0",
  "description": "Cross-platform media tracker: movies, TV, anime, manga, books and games",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "format": "prettier --write .",
    "lint:bp": "node scripts/check-breakpoints.mjs",
    "lint:en": "node --test scripts/english-only.test.mjs",
    "lint:colors": "node --test scripts/colors.test.mjs",
    "lint": "prettier --check . && eslint . --max-warnings 0 && npm run lint:bp && npm run lint:en && npm run lint:colors && npm run lint:guards",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "verify:fe": "npm run lint && npm run check && npm run test && npm run test:ui",
    "verify:rs": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "verify": "npm run verify:fe && npm run verify:rs",
    "lint:guards": "node --test scripts/docs-notes.test.mjs scripts/verify-toolchain.test.mjs scripts/build-docs.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.97.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelsm993/tauri-project.git"
  }
}
