{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SESH",
  "mainBinaryName": "sesh",
  "version": "0.1.0",
  "identifier": "com.rafaelsm993.sesh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "SESH",
        "width": 800,
        "height": 600,
        "minWidth": 360,
        "minHeight": 560,
        "devtools": true 
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://image.tmdb.org https://s4.anilist.co https://media.rawg.io https://*.mzstatic.com",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset: http://localhost:1420 http://127.0.0.1:1420",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1421 ws://127.0.0.1:1421 http://localhost:1420 http://127.0.0.1:1420",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://image.tmdb.org https://s4.anilist.co https://media.rawg.io https://*.mzstatic.com",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/posters/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
    "publisher": "rafaelsm993",
    "copyright": "© 2026 rafaelsm993. MIT License.",
    "category": "Entertainment",
    "shortDescription": "Track movies, TV, anime, manga, books and games.",
    "longDescription": "SESH is a cross-platform media tracker: browse catalogs, keep a library, plan sessions and earn progression rewards, all stored on your device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
